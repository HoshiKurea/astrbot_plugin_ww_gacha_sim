# Ignore everything by default
*

# Whitelist directories (allow git to traverse them)
!src/
!.github/
!tests/
!webui/
!pages/

# Whitelist files in root
!_conf_schema.json
!.gitignore
!CHANGELOG.md
!logo.png
!main.py
!metadata.yaml
!README.md
!requirements.txt
!LICENSE
!requirements-dev.txt
!pyproject.toml

# Whitelist contents of directories
!src/**
!.github/**
!tests/**
!webui/**
!pages/**

# Blacklist specific unwanted paths
src/web/dev/
webui/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
*.pyc
*.zip
